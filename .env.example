# Public site URL — no trailing slash (used for canonical, sitemap, OG URLs).
NEXT_PUBLIC_SITE_URL=https://www.solanawestprices.com

# HTTPS endpoint that accepts POST JSON lead payloads from `submitLeadInquiry`.
# When unset or empty: the form surfaces a visible error and submissions are rejected (no silent failure).
LEAD_WEBHOOK_URL=https://hooks.example.com/your-endpoint
